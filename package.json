{
  "name": "faira",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/collect-api",
    "apps/fulfilment-api",
    "apps/web",
    "apps/collect-web",
    "apps/fulfilment-web"
  ],
  "scripts": {
    "postinstall": "npm run build -w @faira/db && npm run build -w @faira/api-core",
    "build:packages": "npm run build -w @faira/db && npm run build -w @faira/api-core",
    "build:db": "npm run build -w @faira/db",
    "migrate": "npm run migrate -w @faira/db"
  },
  "overrides": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}

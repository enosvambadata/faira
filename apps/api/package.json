    "@supabase/supabase-js": "^2.110.0",
    "africastalking": "^0.8.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "multer": "^2.2.0",
    "paynow": "^2.2.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "standardwebhooks": "^1.0.0",
    "stripe": "^18.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",

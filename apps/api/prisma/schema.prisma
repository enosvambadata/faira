generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
}

enum ShippingMethod {
  MEETUP
  COURIER
  POSTAL
}

enum WeightTier {
  LIGHT
  MEDIUM
  HEAVY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeletionRequestStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum PaymentMethod {
  ECOCASH
  ONEMONEY
  ZIMSWITCH
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum EscrowEntryType {
  HOLD
  RELEASE
  REFUND
  PAYOUT
  COMMISSION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReviewFlagStatus {
  PENDING
  DISMISSED
  REMOVED
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// id matches auth.users.id (Supabase-managed); no Prisma-level relation since
// Prisma doesn't own the auth schema — the FK to auth.users is added by hand
// in the migration SQL instead of being generated from this model.
model User {
  id                         String   @id @db.Uuid
  displayName                String?  @map("display_name")
  avatarUrl                  String?  @map("avatar_url")
  city                       String?
  expoPushToken              String?  @map("expo_push_token")
  pushNotificationsEnabled   Boolean  @default(true) @map("push_notifications_enabled")
  emailNotificationsEnabled  Boolean  @default(true) @map("email_notifications_enabled")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  sellerProfile         SellerProfile?
  listings              Listing[]
  ordersAsBuyer         Order[]        @relation("BuyerOrders")
  wishlistItems         WishlistItem[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  sentMessages          Message[]
  following             Follow[]       @relation("Following")
  followers             Follow[]       @relation("Followers")
  verificationRequests  VerificationRequest[]
  deletionRequests      AccountDeletionRequest[]
  auditLogs             AuditLog[]
  escrowLedgerEntries   EscrowLedgerEntry[]
  disputesRaised        PaymentDispute[]
  payoutRequests        PayoutRequest[]
  reviewsGiven          Review[]                 @relation("ReviewsGiven")
  reviewsReceived       Review[]                 @relation("ReviewsReceived")
  reviewFlagsRaised     ReviewFlag[]
  reportsRaised         Report[]

  @@map("users")
}

// Multiple rows per user are expected over time (a cancelled request
// doesn't block requesting again later) — only application logic (not a
// unique constraint) enforces "at most one PENDING request per user".
model AccountDeletionRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  status       DeletionRequestStatus  @default(PENDING)
  requestedAt  DateTime               @default(now()) @map("requested_at")
  scheduledFor DateTime               @map("scheduled_for")
  processedAt  DateTime?              @map("processed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledFor])
  @@map("account_deletion_requests")
}

// Compliance trail for account-lifecycle actions (deletion requests,
// cancellations, anonymization, data exports) — required by SCRUM-50's
// "Deletion request logged in audit_log table" acceptance criterion.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_log")
}

// A seller's submission of an ID document + selfie for manual review.
// Resubmission is allowed after a rejection, so a seller can have more
// than one row here — only the most recent one is shown to them.
model VerificationRequest {
  id              String              @id @default(uuid()) @db.Uuid
  sellerId        String              @map("seller_id") @db.Uuid
  idDocumentUrl   String              @map("id_document_url")
  selfieUrl       String              @map("selfie_url")
  status          VerificationStatus  @default(PENDING)
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  reviewedAt      DateTime?           @map("reviewed_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@map("verification_requests")
}

// A buyer following a seller — one row per (follower, seller) pair.
model Follow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @map("follower_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  seller   User @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
  @@index([sellerId])
  @@map("follows")
}

model SellerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  businessName String?  @map("business_name")
  isVerified   Boolean  @default(false) @map("is_verified")
  codEnabled   Boolean  @default(false) @map("cod_enabled")
  ratingAvg    Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")
  listings Listing[]

  @@index([parentId])
  @@map("categories")
}

model Listing {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @map("seller_id") @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  title           String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  condition       ListingCondition
  city            String
  imageUrls       String[]         @map("image_urls")
  deliveryOptions String[]         @map("delivery_options")
  // Drives delivery fee calculation (SCRUM-64) — defaulted to LIGHT so
  // existing rows stay valid, but the sell flow requires an explicit
  // choice for new listings.
  weightTier      WeightTier       @default(LIGHT) @map("weight_tier")
  status          ListingStatus    @default(ACTIVE)
  deletedAt       DateTime?        @map("deleted_at")
  // The exact declaration text the seller agreed to and when — stored
  // verbatim (not just a boolean) so the audit trail survives the legal
  // text itself changing later.
  legalSourcingDeclarationText String?   @map("legal_sourcing_declaration_text")
  legalSourcingDeclaredAt      DateTime? @map("legal_sourcing_declared_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  seller        User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes    ListingAttribute[]
  orders        Order[]
  wishlistedBy  WishlistItem[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([city])
  @@index([status])
  @@map("listings")
}

// One conversation per (listing, buyer) pair — a buyer re-opening chat
// about the same listing continues the existing thread instead of
// forking a new one. sellerId is denormalized from listing.sellerId so
// inbox queries ("my conversations as seller") don't need a join.
model Conversation {
  id               String   @id @default(uuid()) @db.Uuid
  listingId        String   @map("listing_id") @db.Uuid
  buyerId          String   @map("buyer_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  archivedByBuyer  Boolean  @default(false) @map("archived_by_buyer")
  archivedBySeller Boolean  @default(false) @map("archived_by_seller")
  mutedByBuyer     Boolean  @default(false) @map("muted_by_buyer")
  mutedBySeller    Boolean  @default(false) @map("muted_by_seller")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

// readAt is nullable and set once the recipient views the message — a
// single timestamp is enough since every conversation here has exactly
// two participants (buyer, seller), unlike a group chat's read receipts.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String?
  imageUrl       String?   @map("image_url")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@map("messages")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("wishlist_items")
}

// Flexible per-category attributes (e.g. size for clothing, storage capacity
// for electronics) — a fixed-column schema doesn't fit "any product category".
model ListingAttribute {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  key       String
  value     String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, key])
  @@map("listing_attributes")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  listingId       String      @map("listing_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  priceAtPurchase Decimal     @map("price_at_purchase") @db.Decimal(10, 2)
  // The option the buyer picked at checkout (SCRUM-59) — one of the
  // seller's listing.deliveryOptions at the time of purchase.
  deliveryOption  String      @map("delivery_option")
  status          OrderStatus @default(PENDING)
  // Tracks the 5-day no-response auto-release window (SCRUM-55) — nullable
  // so "reminder not yet sent" is representable without a sentinel date.
  deliveryReminderDay3SentAt DateTime? @map("delivery_reminder_day3_sent_at")
  deliveryReminderDay4SentAt DateTime? @map("delivery_reminder_day4_sent_at")
  // Fulfillment details the seller fills in when shipping (SCRUM-61) —
  // distinct from deliveryOption, which the buyer picked at checkout.
  // trackingReference only applies to COURIER/POSTAL, not MEETUP.
  shippingMethod    ShippingMethod? @map("shipping_method")
  trackingReference String?         @map("tracking_reference")
  shippedAt         DateTime?       @map("shipped_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  payments      Payment[]
  escrowEntries EscrowLedgerEntry[]
  disputes      PaymentDispute[]
  reviews       Review[]

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

// A buyer's payment attempt against an order. Multiple rows are expected
// per order (a failed EcoCash attempt can be retried) — only one should
// ever reach CONFIRMED, enforced by application logic rather than a DB
// constraint since Paynow's async confirmation means the row is created
// PENDING before the outcome is known.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  paynowReference String?       @map("paynow_reference")
  paynowPollUrl   String?       @map("paynow_poll_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  confirmedAt     DateTime?     @map("confirmed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Append-only record of money movement in and out of escrow. sellerId is
// denormalized from order.listing.sellerId (the same pattern used on
// Conversation) so a seller's available balance — sum(RELEASE) minus
// sum(PAYOUT) — can be queried without joining through order -> listing.
model EscrowLedgerEntry {
  id              String          @id @default(uuid()) @db.Uuid
  // Nullable: PAYOUT entries (and their RELEASE reversal if a payout
  // fails, SCRUM-58) aren't tied to any single order — they're against the
  // seller's aggregate balance across all their released orders.
  orderId         String?         @map("order_id") @db.Uuid
  sellerId        String          @map("seller_id") @db.Uuid
  type            EscrowEntryType
  amount          Decimal         @db.Decimal(10, 2)
  payoutRequestId String?         @map("payout_request_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerId, type])
  @@map("escrow_ledger")
}

// A buyer-raised dispute over a paid order. One dispute per order at a
// time isn't enforced at the DB level — a resolved dispute shouldn't
// block a fresh one, so only the FK relation exists, not a uniqueness
// constraint.
model PaymentDispute {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  raisedById        String        @map("raised_by_id") @db.Uuid
  reason            String
  evidenceImageUrls String[]      @default([]) @map("evidence_image_urls")
  status            DisputeStatus @default(OPEN)
  resolutionNotes   String?       @map("resolution_notes")
  createdAt         DateTime      @default(now()) @map("created_at")
  resolvedAt        DateTime?     @map("resolved_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy User  @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payment_disputes")
}

// A seller's request to withdraw their available escrow balance.
// payoutMethodDetails is freeform (e.g. a mobile money number) rather
// than a FK to a saved-payment-methods table, since Faira doesn't have
// one yet.
model PayoutRequest {
  id                  String       @id @default(uuid()) @db.Uuid
  sellerId            String       @map("seller_id") @db.Uuid
  amount              Decimal      @db.Decimal(10, 2)
  status              PayoutStatus @default(PENDING)
  payoutMethodDetails String       @map("payout_method_details")
  requestedAt         DateTime     @default(now()) @map("requested_at")
  processedAt         DateTime?    @map("processed_at")

  seller        User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  ledgerEntries EscrowLedgerEntry[]

  @@index([sellerId])
  @@index([status])
  @@map("payout_requests")
}

// Configurable by city and weight tier (SCRUM-64) — no admin dashboard
// exists, so this is managed via the ADMIN_TOKEN-gated admin API, same
// pattern as every other "configurable" thing in this app. A missing
// (city, weightTier) row falls back to a hardcoded default in
// deliveryFee.ts rather than failing checkout outright.
model DeliveryFeeRate {
  id         String     @id @default(uuid()) @db.Uuid
  city       String
  weightTier WeightTier @map("weight_tier")
  fee        Decimal    @db.Decimal(10, 2)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@unique([city, weightTier])
  @@map("delivery_fee_rates")
}

// One row per (order, reviewer) — since every order has exactly one buyer
// and one seller, that pair uniquely identifies the direction (buyer
// reviewing the seller, or seller reviewing the buyer), giving "one review
// per completed order per direction" without a separate direction column.
// rating's 1-5 range is enforced with a hand-written CHECK constraint in
// the migration (same approach as the Message body-or-image constraint —
// Prisma has no native way to express a numeric range check). Whether the
// order is actually COMPLETED, and that reviewer/reviewee are its real
// buyer/seller, is enforced at the application layer once SCRUM-67 builds
// the review-creation endpoint — this ticket is schema-only.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User  @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User  @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  flag     ReviewFlag?

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

// One flag per review (SCRUM-69) — either party to the underlying order
// can flag it as abusive/false. A PENDING flag hides the review from
// everyone except its author (see reviews.ts/sellers.ts read paths);
// an admin then DISMISSes it (review becomes visible again) or REMOVEs
// it (stays hidden permanently).
model ReviewFlag {
  id          String           @id @default(uuid()) @db.Uuid
  reviewId    String           @unique @map("review_id") @db.Uuid
  flaggedById String           @map("flagged_by_id") @db.Uuid
  reason      String
  status      ReviewFlagStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  flaggedBy User   @relation(fields: [flaggedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("review_flags")
}

// General-purpose trust & safety report (SCRUM-70), distinct from
// ReviewFlag (which only ever targets a Review). targetId is polymorphic
// — it references a Listing, User, or Message row depending on
// targetType — so there's no Prisma-level FK to the target, only to the
// reporter. This ticket is schema-only; the report-creation endpoint(s)
// and admin moderation queue are built in later tickets in this epic.
model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterId        String           @map("reporter_id") @db.Uuid
  targetType        ReportTargetType @map("target_type")
  targetId          String           @map("target_id") @db.Uuid
  reason            String
  evidenceImageUrls String[]         @default([]) @map("evidence_image_urls")
  status            ReportStatus     @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  resolvedAt        DateTime?        @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

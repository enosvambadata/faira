generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
}

enum ShippingMethod {
  MEETUP
  COURIER
  POSTAL
}

enum WeightTier {
  LIGHT
  MEDIUM
  HEAVY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeletionRequestStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum PaymentMethod {
  ECOCASH
  ONEMONEY
  ZIMSWITCH
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum EscrowEntryType {
  HOLD
  RELEASE
  REFUND
  PAYOUT
  COMMISSION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum ReviewFlagStatus {
  PENDING
  DISMISSED
  REMOVED
}

enum ReportTargetType {
  LISTING
  USER
  MESSAGE
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportReason {
  FAKE_ITEM
  SCAM
  INAPPROPRIATE
  OTHER
}

// id matches auth.users.id (Supabase-managed); no Prisma-level relation since
// Prisma doesn't own the auth schema — the FK to auth.users is added by hand
// in the migration SQL instead of being generated from this model.
model User {
  id                         String   @id @db.Uuid
  displayName                String?  @map("display_name")
  avatarUrl                  String?  @map("avatar_url")
  city                       String?
  expoPushToken              String?  @map("expo_push_token")
  pushNotificationsEnabled   Boolean  @default(true) @map("push_notifications_enabled")
  emailNotificationsEnabled  Boolean  @default(true) @map("email_notifications_enabled")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  sellerProfile         SellerProfile?
  listings              Listing[]
  ordersAsBuyer         Order[]        @relation("BuyerOrders")
  wishlistItems         WishlistItem[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  sentMessages          Message[]
  following             Follow[]       @relation("Following")
  followers             Follow[]       @relation("Followers")
  verificationRequests  VerificationRequest[]
  deletionRequests      AccountDeletionRequest[]
  auditLogs             AuditLog[]
  escrowLedgerEntries   EscrowLedgerEntry[]
  disputesRaised        PaymentDispute[]
  payoutRequests        PayoutRequest[]
  reviewsGiven          Review[]                 @relation("ReviewsGiven")
  reviewsReceived       Review[]                 @relation("ReviewsReceived")
  reviewFlagsRaised     ReviewFlag[]
  reportsRaised         Report[]

  // --- Faira Fulfilment (SCRUM-128) ---
  fulfilmentRoles              UserRole[]
  shipmentsAsSeller             Shipment[]           @relation("ShipmentSeller")
  trackingEventsActed           TrackingEvent[]
  parcelEvidenceCaptured        ParcelEvidence[]
  parcelSealsApplied            ParcelSeal[]
  transportRunsOperated         TransportRun[]
  manifestsFinalized            TransportManifest[]
  sellerSettlements             SellerSettlement[]
  collectionEventsVerified      CollectionEvent[]
  returnRequestsRequested       ReturnRequest[]
  returnEventsActed             ReturnEvent[]
  fulfilmentDisputesRaised      Dispute[]
  supportTicketsRaised          SupportTicket[]
  fulfilmentSellerProfile       FulfilmentSellerProfile?
  fulfilmentVerificationRequests FulfilmentVerificationRequest[]

  @@map("users")
}

// Multiple rows per user are expected over time (a cancelled request
// doesn't block requesting again later) — only application logic (not a
// unique constraint) enforces "at most one PENDING request per user".
model AccountDeletionRequest {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  status       DeletionRequestStatus  @default(PENDING)
  requestedAt  DateTime               @default(now()) @map("requested_at")
  scheduledFor DateTime               @map("scheduled_for")
  processedAt  DateTime?              @map("processed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, scheduledFor])
  @@map("account_deletion_requests")
}

// Compliance trail for account-lifecycle actions (deletion requests,
// cancellations, anonymization, data exports) — required by SCRUM-50's
// "Deletion request logged in audit_log table" acceptance criterion.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("audit_log")
}

// A seller's submission of an ID document + selfie for manual review.
// Resubmission is allowed after a rejection, so a seller can have more
// than one row here — only the most recent one is shown to them.
model VerificationRequest {
  id              String              @id @default(uuid()) @db.Uuid
  sellerId        String              @map("seller_id") @db.Uuid
  idDocumentUrl   String              @map("id_document_url")
  selfieUrl       String              @map("selfie_url")
  status          VerificationStatus  @default(PENDING)
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at")
  reviewedAt      DateTime?           @map("reviewed_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@map("verification_requests")
}

// A buyer following a seller — one row per (follower, seller) pair.
model Follow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @map("follower_id") @db.Uuid
  sellerId   String   @map("seller_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  seller   User @relation("Followers", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
  @@index([sellerId])
  @@map("follows")
}

model SellerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  businessName String?  @map("business_name")
  isVerified   Boolean  @default(false) @map("is_verified")
  codEnabled   Boolean  @default(false) @map("cod_enabled")
  ratingAvg    Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")
  listings Listing[]

  @@index([parentId])
  @@map("categories")
}

model Listing {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @map("seller_id") @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  title           String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  condition       ListingCondition
  city            String
  imageUrls       String[]         @map("image_urls")
  deliveryOptions String[]         @map("delivery_options")
  // Drives delivery fee calculation (SCRUM-64) — defaulted to LIGHT so
  // existing rows stay valid, but the sell flow requires an explicit
  // choice for new listings.
  weightTier      WeightTier       @default(LIGHT) @map("weight_tier")
  status          ListingStatus    @default(ACTIVE)
  deletedAt       DateTime?        @map("deleted_at")
  // The exact declaration text the seller agreed to and when — stored
  // verbatim (not just a boolean) so the audit trail survives the legal
  // text itself changing later.
  legalSourcingDeclarationText String?   @map("legal_sourcing_declaration_text")
  legalSourcingDeclaredAt      DateTime? @map("legal_sourcing_declared_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  seller        User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes    ListingAttribute[]
  orders        Order[]
  wishlistedBy  WishlistItem[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([city])
  @@index([status])
  @@map("listings")
}

// One conversation per (listing, buyer) pair — a buyer re-opening chat
// about the same listing continues the existing thread instead of
// forking a new one. sellerId is denormalized from listing.sellerId so
// inbox queries ("my conversations as seller") don't need a join.
model Conversation {
  id               String   @id @default(uuid()) @db.Uuid
  listingId        String   @map("listing_id") @db.Uuid
  buyerId          String   @map("buyer_id") @db.Uuid
  sellerId         String   @map("seller_id") @db.Uuid
  archivedByBuyer  Boolean  @default(false) @map("archived_by_buyer")
  archivedBySeller Boolean  @default(false) @map("archived_by_seller")
  mutedByBuyer     Boolean  @default(false) @map("muted_by_buyer")
  mutedBySeller    Boolean  @default(false) @map("muted_by_seller")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

// readAt is nullable and set once the recipient views the message — a
// single timestamp is enough since every conversation here has exactly
// two participants (buyer, seller), unlike a group chat's read receipts.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String?
  imageUrl       String?   @map("image_url")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@map("messages")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("wishlist_items")
}

// Flexible per-category attributes (e.g. size for clothing, storage capacity
// for electronics) — a fixed-column schema doesn't fit "any product category".
model ListingAttribute {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  key       String
  value     String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, key])
  @@map("listing_attributes")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  listingId       String      @map("listing_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  priceAtPurchase Decimal     @map("price_at_purchase") @db.Decimal(10, 2)
  // The option the buyer picked at checkout (SCRUM-59) — one of the
  // seller's listing.deliveryOptions at the time of purchase.
  deliveryOption  String      @map("delivery_option")
  status          OrderStatus @default(PENDING)
  // Tracks the 5-day no-response auto-release window (SCRUM-55) — nullable
  // so "reminder not yet sent" is representable without a sentinel date.
  deliveryReminderDay3SentAt DateTime? @map("delivery_reminder_day3_sent_at")
  deliveryReminderDay4SentAt DateTime? @map("delivery_reminder_day4_sent_at")
  // Fulfillment details the seller fills in when shipping (SCRUM-61) —
  // distinct from deliveryOption, which the buyer picked at checkout.
  // trackingReference only applies to COURIER/POSTAL, not MEETUP.
  shippingMethod    ShippingMethod? @map("shipping_method")
  trackingReference String?         @map("tracking_reference")
  shippedAt         DateTime?       @map("shipped_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  payments      Payment[]
  escrowEntries EscrowLedgerEntry[]
  disputes      PaymentDispute[]
  reviews       Review[]

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

// A buyer's payment attempt against an order. Multiple rows are expected
// per order (a failed EcoCash attempt can be retried) — only one should
// ever reach CONFIRMED, enforced by application logic rather than a DB
// constraint since Paynow's async confirmation means the row is created
// PENDING before the outcome is known.
model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  paynowReference String?       @map("paynow_reference")
  paynowPollUrl   String?       @map("paynow_poll_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  confirmedAt     DateTime?     @map("confirmed_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

// Append-only record of money movement in and out of escrow. sellerId is
// denormalized from order.listing.sellerId (the same pattern used on
// Conversation) so a seller's available balance — sum(RELEASE) minus
// sum(PAYOUT) — can be queried without joining through order -> listing.
model EscrowLedgerEntry {
  id              String          @id @default(uuid()) @db.Uuid
  // Nullable: PAYOUT entries (and their RELEASE reversal if a payout
  // fails, SCRUM-58) aren't tied to any single order — they're against the
  // seller's aggregate balance across all their released orders.
  orderId         String?         @map("order_id") @db.Uuid
  sellerId        String          @map("seller_id") @db.Uuid
  type            EscrowEntryType
  amount          Decimal         @db.Decimal(10, 2)
  payoutRequestId String?         @map("payout_request_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sellerId, type])
  @@map("escrow_ledger")
}

// A buyer-raised dispute over a paid order. One dispute per order at a
// time isn't enforced at the DB level — a resolved dispute shouldn't
// block a fresh one, so only the FK relation exists, not a uniqueness
// constraint.
model PaymentDispute {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  raisedById        String        @map("raised_by_id") @db.Uuid
  reason            String
  evidenceImageUrls String[]      @default([]) @map("evidence_image_urls")
  status            DisputeStatus @default(OPEN)
  resolutionNotes   String?       @map("resolution_notes")
  createdAt         DateTime      @default(now()) @map("created_at")
  resolvedAt        DateTime?     @map("resolved_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  raisedBy User  @relation(fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payment_disputes")
}

// A seller's request to withdraw their available escrow balance.
// payoutMethodDetails is freeform (e.g. a mobile money number) rather
// than a FK to a saved-payment-methods table, since Faira doesn't have
// one yet.
model PayoutRequest {
  id                  String       @id @default(uuid()) @db.Uuid
  sellerId            String       @map("seller_id") @db.Uuid
  amount              Decimal      @db.Decimal(10, 2)
  status              PayoutStatus @default(PENDING)
  payoutMethodDetails String       @map("payout_method_details")
  requestedAt         DateTime     @default(now()) @map("requested_at")
  processedAt         DateTime?    @map("processed_at")

  seller        User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  ledgerEntries EscrowLedgerEntry[]

  @@index([sellerId])
  @@index([status])
  @@map("payout_requests")
}

// Configurable by city and weight tier (SCRUM-64) — no admin dashboard
// exists, so this is managed via the ADMIN_TOKEN-gated admin API, same
// pattern as every other "configurable" thing in this app. A missing
// (city, weightTier) row falls back to a hardcoded default in
// deliveryFee.ts rather than failing checkout outright.
model DeliveryFeeRate {
  id         String     @id @default(uuid()) @db.Uuid
  city       String
  weightTier WeightTier @map("weight_tier")
  fee        Decimal    @db.Decimal(10, 2)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@unique([city, weightTier])
  @@map("delivery_fee_rates")
}

// One row per (order, reviewer) — since every order has exactly one buyer
// and one seller, that pair uniquely identifies the direction (buyer
// reviewing the seller, or seller reviewing the buyer), giving "one review
// per completed order per direction" without a separate direction column.
// rating's 1-5 range is enforced with a hand-written CHECK constraint in
// the migration (same approach as the Message body-or-image constraint —
// Prisma has no native way to express a numeric range check). Whether the
// order is actually COMPLETED, and that reviewer/reviewee are its real
// buyer/seller, is enforced at the application layer once SCRUM-67 builds
// the review-creation endpoint — this ticket is schema-only.
model Review {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User  @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User  @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  flag     ReviewFlag?

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

// One flag per review (SCRUM-69) — either party to the underlying order
// can flag it as abusive/false. A PENDING flag hides the review from
// everyone except its author (see reviews.ts/sellers.ts read paths);
// an admin then DISMISSes it (review becomes visible again) or REMOVEs
// it (stays hidden permanently).
model ReviewFlag {
  id          String           @id @default(uuid()) @db.Uuid
  reviewId    String           @unique @map("review_id") @db.Uuid
  flaggedById String           @map("flagged_by_id") @db.Uuid
  reason      String
  status      ReviewFlagStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  resolvedAt  DateTime?        @map("resolved_at")

  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  flaggedBy User   @relation(fields: [flaggedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("review_flags")
}

// General-purpose trust & safety report (SCRUM-70), distinct from
// ReviewFlag (which only ever targets a Review). targetId is polymorphic
// — it references a Listing, User, or Message row depending on
// targetType — so there's no Prisma-level FK to the target, only to the
// reporter.
model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterId        String           @map("reporter_id") @db.Uuid
  targetType        ReportTargetType @map("target_type")
  targetId          String           @map("target_id") @db.Uuid
  // Fixed category (SCRUM-71 acceptance criteria: fake item/scam/
  // inappropriate/other) — the free-text elaboration is `note`, kept
  // separate so admin tooling can filter/aggregate by reason.
  reason            ReportReason
  note              String?
  evidenceImageUrls String[]         @default([]) @map("evidence_image_urls")
  status            ReportStatus     @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  resolvedAt        DateTime?        @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// =====================================================================
// Faira Fulfilment (SCRUM-128) — parcel fulfilment between Faira hubs.
// Shares the User/AuditLog/VerificationRequest models above rather than
// duplicating identity, audit, or seller-verification concepts; adds
// hub, shipment, transport, payment/settlement, and support domain
// models. See docs/fulfilment/02-architecture-decision-record.md and
// docs/fulfilment/03-shipment-state-machine.md for the design rationale.
//
// RBAC is deliberately a single UserRole row (role + optional hub scope)
// rather than separate Role/Permission tables — 8 fixed roles at pilot
// scale don't need a dynamic permission engine yet; see the ADR's
// documented trade-off. Authorization is enforced in the Express API
// layer (requireRole/requireHubAssignment middleware), not via Postgres
// RLS — RLS is not part of this app's request path (Prisma connects to
// Postgres directly, not through PostgREST), so it's defense-in-depth
// at most, never the primary control.
// =====================================================================

enum FulfilmentRole {
  SELLER
  HUB_AGENT
  HUB_SUPERVISOR
  TRANSPORT_OPERATOR
  CUSTOMER_SUPPORT
  FINANCE_ADMIN
  OPERATIONS_ADMIN
  SUPER_ADMIN
}

// hubId is only meaningful for HUB_AGENT/HUB_SUPERVISOR (which hub this
// assignment grants access to); null for every other role. A Transport
// Operator's scope is the TransportRun.operatorUserId field instead of a
// row here — one operator per run is the pilot's actual cardinality, so
// a separate run-assignment table would be unused complexity for now.
model UserRole {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      FulfilmentRole
  hubId     String?        @map("hub_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hub  Hub? @relation(fields: [hubId], references: [id], onDelete: Cascade)

  @@unique([userId, role, hubId])
  @@index([userId])
  @@index([hubId])
  @@map("fulfilment_user_roles")
}

model Hub {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  // Short human-readable code used in shipment references (FF-{code}-######),
  // e.g. "HRE" for Harare — never guessable-sequential on its own since it's
  // paired with a per-hub counter, not a global one.
  code         String   @unique
  city         String
  address      String
  openingHours String   @map("opening_hours")
  isActive     Boolean  @default(true) @map("is_active")
  // Atomically incremented (single UPDATE ... RETURNING) each time a
  // shipment confirms with this hub as origin — the source of the
  // sequence number in that shipment's reference. Never read-then-written
  // separately; see services/shipmentReference.ts.
  nextShipmentSequence Int @default(1) @map("next_shipment_sequence")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staffRoles        UserRole[]
  shipmentsAsOrigin Shipment[]       @relation("OriginHub")
  shipmentsAsDest   Shipment[]       @relation("DestinationHub")
  routesAsOrigin    TransportRoute[] @relation("RouteOrigin")
  routesAsDest      TransportRoute[] @relation("RouteDestination")
  trackingEvents    TrackingEvent[]
  preferredBySellers FulfilmentSellerProfile[]

  @@unique([name])
  @@map("fulfilment_hubs")
}

enum ParcelSizeTier {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

enum FeePayer {
  SELLER
  BUYER
}

// Full lifecycle per docs/fulfilment/03-shipment-state-machine.md.
// Enforced by application code (services/shipmentStateMachine.ts, not
// yet implemented — this ticket is schema-only), never set directly by
// the frontend.
enum ShipmentStatus {
  DRAFT
  AWAITING_PAYMENT
  AWAITING_DROPOFF
  DROPOFF_OVERDUE
  RECEIVED_AT_ORIGIN
  REJECTED_AT_ORIGIN
  INSPECTED
  SEALED
  AWAITING_DISPATCH
  ASSIGNED_TO_RUN
  DISPATCHED
  IN_TRANSIT
  DELAYED
  RECEIVED_AT_DESTINATION
  READY_FOR_COLLECTION
  COLLECTION_OVERDUE
  COLLECTED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNING_TO_SELLER
  RETURNED_TO_SELLER
  CANCELLED
  LOST
  DAMAGED
  DISPUTED
  CLOSED
}

enum ParcelCondition {
  GOOD
  DAMAGED
  SUSPICIOUS
}

model Shipment {
  id                     String           @id @default(uuid()) @db.Uuid
  // Null until SCRUM-135 generates it (only sealed/confirmed shipments
  // need a physical-label reference); still @unique since Postgres
  // treats multiple NULLs as distinct, so this doesn't weaken the
  // uniqueness guarantee once a reference is assigned.
  reference              String?          @unique
  sellerId               String           @map("seller_id") @db.Uuid
  buyerName              String           @map("buyer_name")
  // Phone/WhatsApp number — buyers have no account (pivot brief), so
  // there is no buyerId FK; contact is how tracking links/codes reach them.
  buyerContact           String           @map("buyer_contact")
  originHubId            String           @map("origin_hub_id") @db.Uuid
  destinationHubId       String           @map("destination_hub_id") @db.Uuid
  category               String
  description            String?
  declaredValue          Decimal          @map("declared_value") @db.Decimal(10, 2)
  sizeTier               ParcelSizeTier   @map("size_tier")
  // Both null at DRAFT — chosen at the SCRUM-133 quotation step, not
  // draft creation, since the fee (and who pays it) depends on a computed
  // quote the seller hasn't seen yet.
  feePayer               FeePayer?        @map("fee_payer")
  deliveryFee            Decimal?         @map("delivery_fee") @db.Decimal(10, 2)
  status                 ShipmentStatus   @default(DRAFT)
  dropoffDeadline        DateTime?        @map("dropoff_deadline")
  collectionWindowEndsAt DateTime?        @map("collection_window_ends_at")
  weightKg               Decimal?         @map("weight_kg") @db.Decimal(6, 2)
  dimensions             String?
  condition              ParcelCondition?
  qrCodeUrl              String?          @map("qr_code_url")
  // Future marketplace-integration point (docs/fulfilment/01-marketplace-pause-report.md):
  // deliberately not a foreign key to Order, so Fulfilment has no
  // compile-time dependency on marketplace tables.
  sourceOrderId          String?          @map("source_order_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  seller         User @relation("ShipmentSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  originHub      Hub  @relation("OriginHub", fields: [originHubId], references: [id], onDelete: Restrict)
  destinationHub Hub  @relation("DestinationHub", fields: [destinationHubId], references: [id], onDelete: Restrict)

  trackingEvents  TrackingEvent[]
  evidence        ParcelEvidence[]
  seals           ParcelSeal[]
  manifestEntry   ManifestParcel?
  payment         FulfilmentPayment?
  settlement      SellerSettlement?
  collectionCode  CollectionCode?
  collectionEvent CollectionEvent?
  returnRequest   ReturnRequest?
  disputes        Dispute[]
  notifications   Notification[]
  supportTickets  SupportTicket[]

  @@index([sellerId])
  @@index([status])
  @@index([originHubId])
  @@index([destinationHubId])
  @@map("fulfilment_shipments")
}

// Immutable by convention — no update/delete route is ever exposed for
// this model. One row per status transition, matching the marketplace
// order-timeline pattern but as its own durable table (chain of custody
// requires the full history, not just reconstructible timestamps).
model TrackingEvent {
  id          String          @id @default(uuid()) @db.Uuid
  shipmentId  String          @map("shipment_id") @db.Uuid
  fromStatus  ShipmentStatus? @map("from_status")
  toStatus    ShipmentStatus  @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  hubId       String?         @map("hub_id") @db.Uuid
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  hub      Hub?     @relation(fields: [hubId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([toStatus])
  @@map("fulfilment_tracking_events")
}

enum EvidenceType {
  PARCEL_PHOTO
  SEAL_PHOTO
  PROOF_OF_COLLECTION
  DAMAGE_PHOTO
  RETURN_PHOTO
}

// Cloudinary-hosted (same signed-upload pattern as dispute/report
// evidence, see apps/api/src/lib/cloudinary.ts) — imageUrl is never a
// public bucket URL guessable by ID.
model ParcelEvidence {
  id           String       @id @default(uuid()) @db.Uuid
  shipmentId   String       @map("shipment_id") @db.Uuid
  type         EvidenceType
  imageUrl     String       @map("image_url")
  capturedById String       @map("captured_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  capturedBy User     @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("fulfilment_parcel_evidence")
}

model ParcelSeal {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @map("shipment_id") @db.Uuid
  sealNumber  String   @map("seal_number")
  appliedById String   @map("applied_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  appliedBy User     @relation(fields: [appliedById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@map("fulfilment_parcel_seals")
}

model TransportProvider {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactPhone String?  @map("contact_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  routes TransportRoute[]
  runs   TransportRun[]

  @@map("fulfilment_transport_providers")
}

// Routable between any two hubs (no hardcoded city names) so more
// cities can be added later without a schema change, per the pivot brief.
model TransportRoute {
  id               String   @id @default(uuid()) @db.Uuid
  originHubId      String   @map("origin_hub_id") @db.Uuid
  destinationHubId String   @map("destination_hub_id") @db.Uuid
  providerId       String?  @map("provider_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  originHub      Hub                @relation("RouteOrigin", fields: [originHubId], references: [id], onDelete: Restrict)
  destinationHub Hub                @relation("RouteDestination", fields: [destinationHubId], references: [id], onDelete: Restrict)
  provider       TransportProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  runs           TransportRun[]
  pricingRules   PricingRule[]

  @@unique([originHubId, destinationHubId])
  @@map("fulfilment_transport_routes")
}

enum TransportRunStatus {
  SCHEDULED
  DEPARTED
  ARRIVED
  DELAYED
  CANCELLED
}

model TransportRun {
  id                 String              @id @default(uuid()) @db.Uuid
  routeId            String              @map("route_id") @db.Uuid
  providerId         String?             @map("provider_id") @db.Uuid
  operatorUserId     String?             @map("operator_user_id") @db.Uuid
  vehicleReference   String?             @map("vehicle_reference")
  scheduledDeparture DateTime            @map("scheduled_departure")
  scheduledArrival   DateTime            @map("scheduled_arrival")
  actualDeparture    DateTime?           @map("actual_departure")
  actualArrival      DateTime?           @map("actual_arrival")
  status             TransportRunStatus  @default(SCHEDULED)
  createdAt          DateTime            @default(now()) @map("created_at")

  route     TransportRoute      @relation(fields: [routeId], references: [id], onDelete: Restrict)
  provider  TransportProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  operator  User?               @relation(fields: [operatorUserId], references: [id], onDelete: SetNull)
  manifests TransportManifest[]

  @@index([routeId])
  @@index([status])
  @@map("fulfilment_transport_runs")
}

enum ManifestStatus {
  OPEN
  FINALIZED
  DEPARTED
  ARRIVED
  RECONCILED
  CANCELLED
}

// Immutable once FINALIZED — no edit route is exposed past that point
// (see docs/fulfilment/03-shipment-state-machine.md's dispatch-manifest
// ticket notes).
model TransportManifest {
  id            String         @id @default(uuid()) @db.Uuid
  runId         String         @map("run_id") @db.Uuid
  status        ManifestStatus @default(OPEN)
  finalizedAt   DateTime?      @map("finalized_at")
  finalizedById String?        @map("finalized_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")

  run         TransportRun     @relation(fields: [runId], references: [id], onDelete: Restrict)
  finalizedBy User?            @relation(fields: [finalizedById], references: [id], onDelete: SetNull)
  parcels     ManifestParcel[]

  @@index([runId])
  @@map("fulfilment_transport_manifests")
}

// shipmentId is unique — a shipment can only be on one active manifest
// at a time, which is what makes "assign to a run" a real state
// transition rather than an unbounded many-to-many.
model ManifestParcel {
  id           String    @id @default(uuid()) @db.Uuid
  manifestId   String    @map("manifest_id") @db.Uuid
  shipmentId   String    @unique @map("shipment_id") @db.Uuid
  scannedOutAt DateTime? @map("scanned_out_at")
  scannedInAt  DateTime? @map("scanned_in_at")
  shortShipped Boolean   @default(false) @map("short_shipped")
  createdAt    DateTime  @default(now()) @map("created_at")

  manifest TransportManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  shipment Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([manifestId])
  @@map("fulfilment_manifest_parcels")
}

// Separate from the marketplace Payment model (which is Order-scoped) —
// same shape, different owning entity. No card data is ever stored here;
// providerReference is the payment provider's own transaction id.
enum FulfilmentPaymentMethod {
  ECOCASH
  ONEMONEY
  ZIMSWITCH
  CASH_ON_COLLECTION
  CARD
}

enum FulfilmentPaymentStatus {
  PENDING
  AUTHORISED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model FulfilmentPayment {
  id                String                   @id @default(uuid()) @db.Uuid
  shipmentId        String                   @unique @map("shipment_id") @db.Uuid
  method            FulfilmentPaymentMethod
  status            FulfilmentPaymentStatus  @default(PENDING)
  amount            Decimal                  @db.Decimal(10, 2)
  providerReference String?                  @map("provider_reference")
  createdAt         DateTime                 @default(now()) @map("created_at")
  confirmedAt       DateTime?                @map("confirmed_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("fulfilment_payments")
}

enum SettlementStatus {
  PENDING
  SETTLED
  FAILED
  REVERSED
}

// Mirrors apps/api/src/services/escrowRelease.ts's commission-split
// pattern — created once per COLLECTED shipment (never derived/recreated),
// moved to SETTLED by a scheduled job once eligible.
model SellerSettlement {
  id          String           @id @default(uuid()) @db.Uuid
  shipmentId  String           @unique @map("shipment_id") @db.Uuid
  sellerId    String           @map("seller_id") @db.Uuid
  grossAmount Decimal          @map("gross_amount") @db.Decimal(10, 2)
  commission  Decimal          @db.Decimal(10, 2)
  netAmount   Decimal          @map("net_amount") @db.Decimal(10, 2)
  status      SettlementStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  settledAt   DateTime?        @map("settled_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  seller   User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([status])
  @@map("fulfilment_seller_settlements")
}

// Configurable per route+size (no hardcoded route prices, per the pivot
// brief's explicit anti-pattern list). Missing combos fall back to a
// SystemConfiguration default at quote time rather than blocking checkout.
model PricingRule {
  id        String         @id @default(uuid()) @db.Uuid
  routeId   String         @map("route_id") @db.Uuid
  sizeTier  ParcelSizeTier @map("size_tier")
  fee       Decimal        @db.Decimal(10, 2)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sizeTier])
  @@map("fulfilment_pricing_rules")
}

// codeHash, never the plaintext code, is stored — same principle as
// password hashing. attempts supports rate-limiting verification tries.
model CollectionCode {
  id         String    @id @default(uuid()) @db.Uuid
  shipmentId String    @unique @map("shipment_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("fulfilment_collection_codes")
}

// The proof-of-collection record itself (SCRUM-146) — immutable once
// created, one per COLLECTED shipment.
model CollectionEvent {
  id               String   @id @default(uuid()) @db.Uuid
  shipmentId       String   @unique @map("shipment_id") @db.Uuid
  verifiedById     String   @map("verified_by_id") @db.Uuid
  idCheckPerformed Boolean  @default(false) @map("id_check_performed")
  // Set only when a high-value parcel's ID check was skipped via a
  // supervisor override -- required by SCRUM-145's server-side enforcement
  // whenever idCheckPerformed is false above the configured value threshold.
  idCheckOverrideReason String? @map("id_check_override_reason")
  proofImageUrl    String?  @map("proof_image_url")
  createdAt        DateTime @default(now()) @map("created_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  verifiedBy User     @relation(fields: [verifiedById], references: [id], onDelete: Restrict)

  @@map("fulfilment_collection_events")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RETURNING
  RETURNED
  CLOSED
}

model ReturnRequest {
  id            String       @id @default(uuid()) @db.Uuid
  shipmentId    String       @unique @map("shipment_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  reason        String
  status        ReturnStatus @default(REQUESTED)
  createdAt     DateTime     @default(now()) @map("created_at")
  resolvedAt    DateTime?    @map("resolved_at")

  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  requestedBy User          @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  events      ReturnEvent[]

  @@map("fulfilment_return_requests")
}

model ReturnEvent {
  id              String       @id @default(uuid()) @db.Uuid
  returnRequestId String       @map("return_request_id") @db.Uuid
  status          ReturnStatus
  actorUserId     String?      @map("actor_user_id") @db.Uuid
  notes           String?
  createdAt       DateTime     @default(now()) @map("created_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
  @@map("fulfilment_return_events")
}

// Named Dispute (not PaymentDispute, which is the marketplace's existing
// order-payment-dispute model) to avoid a naming collision while keeping
// each product line's dispute concept distinct.
enum FulfilmentDisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Dispute {
  id              String                  @id @default(uuid()) @db.Uuid
  shipmentId      String                  @map("shipment_id") @db.Uuid
  // Null when raised by a buyer via Customer Support (buyers have no
  // account) rather than directly by an authenticated user.
  raisedById      String?                 @map("raised_by_id") @db.Uuid
  reason          String
  status          FulfilmentDisputeStatus @default(OPEN)
  resolutionNotes String?                 @map("resolution_notes")
  createdAt       DateTime                @default(now()) @map("created_at")
  resolvedAt      DateTime?               @map("resolved_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  raisedBy User?    @relation(fields: [raisedById], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status])
  @@map("fulfilment_disputes")
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}

// event is a stable string key (e.g. "SHIPMENT_DISPATCHED") rather than
// an enum so new lifecycle events can be added via a data migration
// (seeding a new template row) instead of a schema migration.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  event     String
  channel   NotificationChannel
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  notifications Notification[]

  @@unique([event, channel])
  @@map("fulfilment_notification_templates")
}

// recipient is a phone number, email, or push token — not a User FK,
// since buyer notifications have no associated account.
model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  shipmentId String?             @map("shipment_id") @db.Uuid
  templateId String?             @map("template_id") @db.Uuid
  recipient  String
  channel    NotificationChannel
  status     NotificationStatus  @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?             @map("last_error")
  sentAt     DateTime?           @map("sent_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  shipment Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status])
  @@map("fulfilment_notifications")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// contactInfo carries the buyer's phone/email when raisedById is null
// (buyer support requests have no account to attribute to).
model SupportTicket {
  id          String              @id @default(uuid()) @db.Uuid
  shipmentId  String?             @map("shipment_id") @db.Uuid
  raisedById  String?             @map("raised_by_id") @db.Uuid
  contactInfo String?             @map("contact_info")
  subject     String
  message     String
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at")
  resolvedAt  DateTime?           @map("resolved_at")

  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  raisedBy User?     @relation(fields: [raisedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("fulfilment_support_tickets")
}

// Simple key/value store for tunable operational parameters (drop-off
// deadline hours, collection window days, declared-value limits per
// verification tier, commission rate, ...) that will evolve faster than
// a rigid schema should — avoids a migration for every tunable.
model SystemConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("fulfilment_system_configuration")
}

// =====================================================================
// Seller onboarding + verification (SCRUM-130/131). Deliberately separate
// from the marketplace's SellerProfile/VerificationRequest models rather
// than extending them — the field shapes genuinely differ (business
// docs, shop photo, 9-status workflow vs. marketplace's simple 3-status
// one), and Fulfilment sellers/marketplace sellers share only the
// underlying User identity, not a seller-profile record.
//
// Verification documents use private Supabase Storage with signed URLs
// (not Cloudinary, which the rest of this app uses for images) — an
// explicit product requirement for identity/business documents
// specifically, the most sensitive file type in the system. This is a
// deliberate amendment to docs/fulfilment/02-architecture-decision-record.md's
// general "continue with Cloudinary" position, scoped to this one
// document category.
// =====================================================================

enum SellerOnboardingStatus {
  DRAFT
  SUBMITTED
}

enum FulfilmentSellerType {
  INDIVIDUAL
  REGISTERED_BUSINESS
}

// One row per user, upserted step-by-step as the registration wizard
// progresses (save-and-resume) — every field is optional at the model
// level because a DRAFT can be partially filled; completeness is
// validated at submission time by application code, not by NOT NULL
// constraints that would block saving an in-progress draft.
model FulfilmentSellerProfile {
  id                String                 @id @default(uuid()) @db.Uuid
  userId            String                 @unique @map("user_id") @db.Uuid
  fullName          String?                @map("full_name")
  mobileNumber      String?                @map("mobile_number")
  sellerType        FulfilmentSellerType?  @map("seller_type")
  businessName      String?                @map("business_name")
  productCategories String[]               @default([]) @map("product_categories")
  hasPhysicalShop   Boolean?               @map("has_physical_shop")
  shopAddress       String?                @map("shop_address")
  city              String?
  preferredHubId    String?                @map("preferred_hub_id") @db.Uuid
  nationalIdNumber  String?                @map("national_id_number")
  agreedToTermsAt   DateTime?              @map("agreed_to_terms_at")
  status            SellerOnboardingStatus @default(DRAFT)
  submittedAt       DateTime?              @map("submitted_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredHub Hub? @relation(fields: [preferredHubId], references: [id], onDelete: SetNull)

  @@map("fulfilment_seller_profiles")
}

enum FulfilmentVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  MORE_INFO_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

// idDocumentUrl/businessDocumentUrl/shopPhotoUrl store the Supabase
// Storage object path (not a public URL) — access is always mediated
// through a freshly generated signed URL, never a stored public link.
model FulfilmentVerificationRequest {
  id                  String                       @id @default(uuid()) @db.Uuid
  sellerId            String                       @map("seller_id") @db.Uuid
  status              FulfilmentVerificationStatus @default(NOT_STARTED)
  idDocumentUrl       String?                      @map("id_document_url")
  businessDocumentUrl String?                      @map("business_document_url")
  shopPhotoUrl        String?                      @map("shop_photo_url")
  reviewNotes         String?                      @map("review_notes")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  reviewedAt          DateTime?                    @map("reviewed_at")

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@map("fulfilment_verification_requests")
}

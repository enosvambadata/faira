generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// id matches auth.users.id (Supabase-managed); no Prisma-level relation since
// Prisma doesn't own the auth schema — the FK to auth.users is added by hand
// in the migration SQL instead of being generated from this model.
model User {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  city        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sellerProfile         SellerProfile?
  listings              Listing[]
  ordersAsBuyer         Order[]        @relation("BuyerOrders")
  wishlistItems         WishlistItem[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  sentMessages          Message[]

  @@map("users")
}

model SellerProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  businessName String?  @map("business_name")
  isVerified   Boolean  @default(false) @map("is_verified")
  ratingAvg    Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount  Int      @default(0) @map("rating_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_profiles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")
  listings Listing[]

  @@index([parentId])
  @@map("categories")
}

model Listing {
  id              String           @id @default(uuid()) @db.Uuid
  sellerId        String           @map("seller_id") @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  title           String
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  condition       ListingCondition
  city            String
  imageUrls       String[]         @map("image_urls")
  deliveryOptions String[]         @map("delivery_options")
  status          ListingStatus    @default(ACTIVE)
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  seller        User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributes    ListingAttribute[]
  orders        Order[]
  wishlistedBy  WishlistItem[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([city])
  @@index([status])
  @@map("listings")
}

// One conversation per (listing, buyer) pair — a buyer re-opening chat
// about the same listing continues the existing thread instead of
// forking a new one. sellerId is denormalized from listing.sellerId so
// inbox queries ("my conversations as seller") don't need a join.
model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  sellerId  String   @map("seller_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversations")
}

// readAt is nullable and set once the recipient views the message — a
// single timestamp is enough since every conversation here has exactly
// two participants (buyer, seller), unlike a group chat's read receipts.
model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String?
  imageUrl       String?   @map("image_url")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@map("messages")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("wishlist_items")
}

// Flexible per-category attributes (e.g. size for clothing, storage capacity
// for electronics) — a fixed-column schema doesn't fit "any product category".
model ListingAttribute {
  id        String @id @default(uuid()) @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  key       String
  value     String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, key])
  @@map("listing_attributes")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  listingId       String      @map("listing_id") @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  priceAtPurchase Decimal     @map("price_at_purchase") @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@map("orders")
}

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Send SMS hook — Standard Webhooks signing secret (whsec_...)
SUPABASE_SEND_SMS_HOOK_SECRET=whsec_your-hook-secret

# Africa's Talking (SMS/OTP delivery)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key

# Cloudinary (avatar upload/resize)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Paynow (EcoCash/OneMoney/Zimswitch payments)
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
API_BASE_URL=http://localhost:3000
MOBILE_APP_URL=https://faira.app
WEB_APP_URL=http://localhost:3100

# Buyer tracking links (SCRUM-143) — HMAC signing secret, generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
TRACKING_TOKEN_SECRET=your-tracking-token-secret

# Sentry (error monitoring) — DSN is not secret, safe to expose
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Logging
LOG_LEVEL=info

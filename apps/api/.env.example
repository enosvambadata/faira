# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Send SMS hook — Standard Webhooks signing secret (whsec_...)
SUPABASE_SEND_SMS_HOOK_SECRET=whsec_your-hook-secret

# Africa's Talking (SMS/OTP delivery)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key

# Cloudinary (avatar upload/resize)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Paynow (EcoCash/OneMoney/Zimswitch payments)
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
API_BASE_URL=http://localhost:3000
MOBILE_APP_URL=https://faira.app
WEB_APP_URL=http://localhost:3100

# Stripe (UK / GBP card payments — Vamba Collect). Env-gated: the payments
# feature stays dormant until both are set. Use sk_test_/whsec_ in test mode.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret

# Vamba Collect tracking links — HMAC signing secret for guest booking +
# shipment tracking tokens. REQUIRED: the API refuses to boot without it
# (see requiredEnv.ts), because a missing secret would let a booking commit
# and then fail to mint its tracking link. Generate: openssl rand -hex 32
COLLECT_UK_TRACKING_TOKEN_SECRET=change-me-openssl-rand-hex-32

# Twilio (UK SMS — Vamba Collect). REQUIRED for real UK delivery: the default
# Africa's Talking transport reaches African telcos only and cannot deliver to
# +44 numbers. Without these, customer SMS silently no-ops on UK numbers (email
# still works if Resend is set). All three must be present to use Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Resend (transactional email — the reliable second channel for Vamba Collect
# customers and driver approve/reject mail). Both must be set or email no-ops.
RESEND_API_KEY=
EMAIL_FROM=Vamba Collect <updates@updates.vambadata.com>

# Buyer tracking links (SCRUM-143) — HMAC signing secret, generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
TRACKING_TOKEN_SECRET=your-tracking-token-secret

# Sentry (error monitoring) — DSN is not secret, safe to expose
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id

# Logging
LOG_LEVEL=info

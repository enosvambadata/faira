# Faira API
EXPO_PUBLIC_API_URL=https://your-api-host

# Supabase (client-safe values only — never put the secret/service_role key here)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Sentry (error monitoring) — DSN is not secret, safe to expose
EXPO_PUBLIC_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
